<?xml version="1.0" encoding="utf-8"?>
<!-- Yayındaki sunucu HTTPS'tir. Evdeki deneme sunucusu (ör. http://192.168.1.20:3000)
     için şifresiz bağlantı açık bırakıldı; ama Api.java yalnızca yerel ağ
     adreslerinde (localhost, 10.x, 172.16-31.x, 192.168.x) http'ye izin verir,
     internetteki adreslere yalnızca https ile gidilir. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
